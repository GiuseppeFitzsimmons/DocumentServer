# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (docker-compose.dev.yml exposes on localhost:5432)
DATABASE_URL=postgres://portal:portal@localhost:5432/portal

# Redis (docker-compose.dev.yml exposes on localhost:6379)
REDIS_URL=redis://localhost:6379

# Session
SESSION_SECRET=dev-session-secret-min-16-chars

# DocumentServer (docker-compose.dev.yml exposes on localhost:8080)
DS_URL=http://localhost:8080
DS_JWT_SECRET=euro-office-dev-jwt-secret-key-2026

# File storage (local directory for dev)
FILE_STORAGE_PATH=./data/files

# Platform base URL (must be reachable by DocumentServer container)
# On Linux: use your host IP on the docker bridge (typically 172.17.0.1)
# Run: ip addr show docker0 | grep inet | awk '{print $2}' | cut -d/ -f1
PLATFORM_BASE_URL=http://172.17.0.1:3000

# S3-compatible Object Storage (optional for dev — leave empty to skip)
OVH_S3_ENDPOINT=
OVH_S3_BUCKET=
OVH_S3_ACCESS_KEY=
OVH_S3_SECRET_KEY=
OVH_S3_REGION=

# Mail (optional for dev)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_DOMAIN=eurobureau.eu
DKIM_PRIVATE_KEY=
