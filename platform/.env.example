# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://portal:portal@localhost:5432/portal

# Redis
REDIS_URL=redis://localhost:6379

# Session
SESSION_SECRET=change-me-to-a-random-string

# DocumentServer
DS_URL=http://localhost:8080
DS_JWT_SECRET=euro-office-dev-jwt-secret-key-2026

# S3-compatible Object Storage (Hetzner)
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=euro-office-files
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=fsn1

# Platform base URL (reachable by DocumentServer over Docker network)
PLATFORM_BASE_URL=http://platform:3000
