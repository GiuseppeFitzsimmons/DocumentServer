<h1>Request beta access</h1>
<% if (error) { %>
  <div class="error"><%= error %></div>
<% } %>
<% if (success) { %>
  <div class="success"><%= success %></div>
<% } else { %>
<p style="font-size:14px;color:#555;margin:0 0 20px;line-height:1.6;">EuroBureau is in closed beta. Fill in your details below and we'll get back to you shortly.</p>
<form method="POST" action="/register">
  <div class="form-group">
    <label for="displayName">Name</label>
    <input type="text" id="displayName" name="displayName" required autofocus />
  </div>
  <div class="form-group">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" required />
  </div>
  <div class="form-group">
    <label for="reason">Tell us briefly why you'd like access <span style="color:#999;font-weight:normal;">(optional)</span></label>
    <textarea id="reason" name="reason" maxlength="1000" rows="3" style="width:100%;padding:8px 10px;border:1px solid #ddd;border-radius:3px;font-family:inherit;font-size:14px;resize:vertical;"></textarea>
  </div>
  <button type="submit" class="btn">Request access</button>
</form>
<% } %>
<div class="link">
  <a href="/login">Already have an account? Sign in</a>
</div>
