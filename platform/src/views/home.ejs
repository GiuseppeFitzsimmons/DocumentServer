<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EuroBureau</title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 0 24px;
    }

    header {
      padding: 32px 0;
      text-align: center;
      border-bottom: 1px solid #eee;
    }

    header .wordmark {
      font-size: 18px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    .hero {
      padding: 96px 0 64px;
      text-align: center;
    }

    .hero h1 {
      font-size: 42px;
      font-weight: normal;
      line-height: 1.3;
      margin-bottom: 24px;
      letter-spacing: -0.01em;
    }

    .hero .subtitle {
      font-size: 18px;
      color: #444;
      max-width: 600px;
      margin: 0 auto 40px;
      line-height: 1.7;
    }

    .hero .launch-date {
      font-size: 14px;
      color: #888;
      margin-bottom: 32px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .cta-group {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .cta-group .btn {
      display: inline-block;
      width: auto;
      padding: 14px 32px;
      text-decoration: none;
    }

    .btn-secondary {
      background: #fff;
      color: #111;
      border: 2px solid #111;
    }

    .btn-secondary:hover {
      background: #f5f5f5;
      color: #111;
    }

    .carousel-section {
      padding: 64px 0;
    }

    /* Widen just this section so the arrow gutters don't eat into the slide. */
    .carousel-section .container {
      max-width: 1040px;
    }

    .carousel {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .carousel-viewport {
      flex: 1 1 auto;
      min-width: 0;
      overflow: hidden;
      border-radius: 6px;
    }

    .carousel-track {
      display: flex;
      transition: transform 0.5s ease;
    }

    .carousel-slide {
      min-width: 100%;
      box-sizing: border-box;
      display: flex;
      align-items: center;
      gap: 40px;
      padding: 8px;
    }

    .carousel-image {
      flex: 1 1 60%;
      min-width: 0;
    }

    .carousel-image img {
      width: 100%;
      display: block;
      border: 1px solid #e0e0e0;
      border-radius: 4px;
      box-shadow: 0 8px 40px rgba(0, 0, 0, 0.06);
    }

    .carousel-caption {
      flex: 1 1 40%;
      text-align: left;
    }

    .carousel-caption h3 {
      font-size: 22px;
      font-weight: normal;
      margin: 0 0 12px;
      color: #111;
      line-height: 1.3;
    }

    .carousel-caption p {
      font-size: 16px;
      color: #444;
      line-height: 1.7;
      margin: 0;
    }

    /* Wide slide: image centered with a subtitle underneath, no side caption. */
    .carousel-slide-wide {
      flex-direction: column;
      gap: 16px;
    }

    .carousel-slide-wide .carousel-image {
      flex: 0 0 auto;
      width: 100%;
    }

    .carousel-slide-wide .carousel-caption {
      flex: 0 0 auto;
      text-align: center;
    }

    .carousel-subtitle {
      font-size: 18px;
      color: #555;
    }

    .carousel-arrow {
      flex: 0 0 auto;
      width: 44px;
      height: 44px;
      border: 1px solid #ddd;
      background: #fff;
      border-radius: 50%;
      font-size: 24px;
      line-height: 1;
      color: #333;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s, border-color 0.15s;
    }

    .carousel-arrow:hover { background: #f5f5f5; border-color: #999; }

    .carousel-dots {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 24px;
    }

    .carousel-dot {
      width: 9px;
      height: 9px;
      padding: 0;
      border: none;
      border-radius: 50%;
      background: #ccc;
      cursor: pointer;
      transition: background 0.15s, transform 0.15s;
    }

    .carousel-dot.active { background: #111; transform: scale(1.2); }

    .faq {
      padding: 80px 0;
      border-top: 1px solid #eee;
    }

    .faq h2 {
      font-size: 28px;
      font-weight: normal;
      text-align: center;
      margin-bottom: 48px;
    }

    .faq-item {
      margin-bottom: 36px;
    }

    .faq-item h3 {
      font-size: 17px;
      font-weight: normal;
      margin-bottom: 8px;
      color: #111;
    }

    .faq-item p {
      font-size: 15px;
      color: #444;
      line-height: 1.8;
    }

    footer {
      padding: 40px 0;
      text-align: center;
      border-top: 1px solid #eee;
      font-size: 13px;
      color: #888;
    }

    footer a {
      color: #888;
      text-decoration: none;
    }

    footer a:hover {
      color: #444;
    }

    @media (max-width: 760px) {
      .carousel-slide { flex-direction: column; gap: 20px; }
      .carousel-caption { text-align: center; }
      .carousel-caption h3 { font-size: 20px; }
      .carousel { gap: 8px; }
      .carousel-arrow { width: 36px; height: 36px; font-size: 20px; }
    }

    @media (max-width: 600px) {
      .hero { padding: 64px 0 48px; }
      .hero h1 { font-size: 30px; }
      .hero .subtitle { font-size: 16px; }
      .cta-group { flex-direction: column; align-items: center; }
      .cta-group .btn { width: 100%; max-width: 280px; text-align: center; }
    }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <span class="wordmark">EuroBureau</span>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container">
        <h1>EuroBureau</h1>
        <p class="subtitle">EuroBureau is the AI-free, privacy-first, GDPR-compliant, transparent and open-source, online office customised for self-published authors.</p>
        <p class="launch-date">The official launch of EuroBureau is scheduled for December 1st, 2026.</p>
        <div class="cta-group">
          <a href="/register" class="btn">Try now</a>
          <a href="/login" class="btn btn-secondary">Log in</a>
        </div>
      </div>
    </section>

    <section class="carousel-section">
      <div class="container">
        <div class="carousel" id="carousel" aria-roledescription="carousel" aria-label="EuroBureau features">
          <button class="carousel-arrow carousel-prev" id="carousel-prev" aria-label="Previous slide">&#8249;</button>
          <div class="carousel-viewport">
          <div class="carousel-track" id="carousel-track">
            <!-- Slides -->
            <div class="carousel-slide carousel-slide-wide" role="group" aria-roledescription="slide">
              <div class="carousel-image"><img src="/carousel/eb-full-screen.png" alt="The full EuroBureau editor" /></div>
              <div class="carousel-caption">
                <p class="carousel-subtitle">Your full editor in view</p>
              </div>
            </div>
            <div class="carousel-slide" role="group" aria-roledescription="slide">
              <div class="carousel-image"><img src="/carousel/eb-typography-pop.png" alt="Rich typography controls" /></div>
              <div class="carousel-caption">
                <h3>Typography tooling</h3>
                <p>Fine-grained control over type so your manuscript looks exactly the way you intend.</p>
              </div>
            </div>
            <div class="carousel-slide" role="group" aria-roledescription="slide">
              <div class="carousel-image"><img src="/carousel/eb-fonts.png" alt="A curated font library" /></div>
              <div class="carousel-caption">
                <h3>Curated font library</h3>
                <p>Hand-picked fonts suited to publishing, guaranteed to fulfill licensing requirements.</p>
              </div>
            </div>
            <div class="carousel-slide" role="group" aria-roledescription="slide">
              <div class="carousel-image"><img src="/carousel/eb-dropcap.png" alt="Decorative drop caps" /></div>
              <div class="carousel-caption">
                <h3>Elegant drop caps</h3>
                <p>Drop caps that render beautifully in print and EPUB.</p>
              </div>
            </div>
            <div class="carousel-slide" role="group" aria-roledescription="slide">
              <div class="carousel-image"><img src="/carousel/eb-advanced-paragraph.png" alt="Advanced paragraph layout" /></div>
              <div class="carousel-caption">
                <h3>Advanced paragraph layout</h3>
                <p>Mirrored gutters, precise spacing and more, for print-ready layouts.</p>
              </div>
            </div>
            <div class="carousel-slide" role="group" aria-roledescription="slide">
              <div class="carousel-image"><img src="/carousel/eb-stylesheets.png" alt="Reusable stylesheets" /></div>
              <div class="carousel-caption">
                <h3>Consistent stylesheets</h3>
                <p>Create custom stylesheets and display a consistent style across your document.</p>
              </div>
            </div>
            <div class="carousel-slide" role="group" aria-roledescription="slide">
              <div class="carousel-image"><img src="/carousel/eb-publishing-exports.png" alt="Publishing-ready exports" /></div>
              <div class="carousel-caption">
                <h3>Publishing-ready exports</h3>
                <p>Export clean, platform-ready (including KDP) EPUB and PDF built to meet self-publishing standards.</p>
              </div>
            </div>
          </div>
          </div>
          <button class="carousel-arrow carousel-next" id="carousel-next" aria-label="Next slide">&#8250;</button>
        </div>

        <div class="carousel-dots" id="carousel-dots" role="tablist" aria-label="Choose slide"></div>
      </div>
    </section>

  </main>

  <footer>
    <div class="container">
      <p>&copy; 2026 EuroBureau &middot; <a href="/terms">Terms</a> &middot; <a href="/faq">FAQ</a></p>
    </div>
  </footer>

  <script>
    (function () {
      var track = document.getElementById('carousel-track');
      var slides = track ? track.children : [];
      var prevBtn = document.getElementById('carousel-prev');
      var nextBtn = document.getElementById('carousel-next');
      var dotsWrap = document.getElementById('carousel-dots');
      if (!track || slides.length === 0) return;

      var index = 0;
      var count = slides.length;
      var AUTO_MS = 6000;
      var timer = null;

      var dots = [];
      for (var i = 0; i < count; i++) {
        var dot = document.createElement('button');
        dot.className = 'carousel-dot' + (i === 0 ? ' active' : '');
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', 'Slide ' + (i + 1));
        (function (n) { dot.addEventListener('click', function () { goTo(n); restart(); }); })(i);
        dotsWrap.appendChild(dot);
        dots.push(dot);
      }

      function render() {
        track.style.transform = 'translateX(-' + (index * 100) + '%)';
        for (var i = 0; i < dots.length; i++) {
          dots[i].classList.toggle('active', i === index);
        }
      }

      function goTo(n) { index = (n + count) % count; render(); }
      function next() { goTo(index + 1); }
      function prev() { goTo(index - 1); }

      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function start() { stop(); if (!paused) timer = setInterval(next, AUTO_MS); }
      function restart() { start(); }

      nextBtn.addEventListener('click', function () { next(); restart(); });
      prevBtn.addEventListener('click', function () { prev(); restart(); });

      var paused = false;
      var carousel = document.getElementById('carousel');
      carousel.addEventListener('mouseenter', function () { paused = true; stop(); });
      carousel.addEventListener('mouseleave', function () { paused = false; start(); });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft') { prev(); restart(); }
        else if (e.key === 'ArrowRight') { next(); restart(); }
      });

      render();
      start();
    })();
  </script>
</body>
</html>
