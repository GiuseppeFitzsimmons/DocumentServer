<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EuroBureau</title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 0 24px;
    }

    header {
      padding: 32px 0;
      text-align: center;
      border-bottom: 1px solid #eee;
    }

    header .wordmark {
      font-size: 18px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    .hero {
      padding: 96px 0 64px;
      text-align: center;
    }

    .hero h1 {
      font-size: 42px;
      font-weight: normal;
      line-height: 1.3;
      margin-bottom: 24px;
      letter-spacing: -0.01em;
    }

    .hero .subtitle {
      font-size: 18px;
      color: #444;
      max-width: 600px;
      margin: 0 auto 40px;
      line-height: 1.7;
    }

    .hero .launch-date {
      font-size: 14px;
      color: #888;
      margin-bottom: 32px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .cta-group {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .cta-group .btn {
      display: inline-block;
      width: auto;
      padding: 14px 32px;
      text-decoration: none;
    }

    .btn-secondary {
      background: #fff;
      color: #111;
      border: 2px solid #111;
    }

    .btn-secondary:hover {
      background: #f5f5f5;
      color: #111;
    }

    .screenshot {
      padding: 64px 0;
      text-align: center;
    }

    .screenshot img {
      width: 100%;
      max-width: 900px;
      border: 1px solid #e0e0e0;
      border-radius: 4px;
      box-shadow: 0 8px 40px rgba(0, 0, 0, 0.06);
    }

    .faq {
      padding: 80px 0;
      border-top: 1px solid #eee;
    }

    .faq h2 {
      font-size: 28px;
      font-weight: normal;
      text-align: center;
      margin-bottom: 48px;
    }

    .faq-item {
      margin-bottom: 36px;
    }

    .faq-item h3 {
      font-size: 17px;
      font-weight: normal;
      margin-bottom: 8px;
      color: #111;
    }

    .faq-item p {
      font-size: 15px;
      color: #444;
      line-height: 1.8;
    }

    footer {
      padding: 40px 0;
      text-align: center;
      border-top: 1px solid #eee;
      font-size: 13px;
      color: #888;
    }

    footer a {
      color: #888;
      text-decoration: none;
    }

    footer a:hover {
      color: #444;
    }

    @media (max-width: 600px) {
      .hero { padding: 64px 0 48px; }
      .hero h1 { font-size: 30px; }
      .hero .subtitle { font-size: 16px; }
      .cta-group { flex-direction: column; align-items: center; }
      .cta-group .btn { width: 100%; max-width: 280px; text-align: center; }
    }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <span class="wordmark">EuroBureau</span>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container">
        <h1>EuroBureau</h1>
        <p class="subtitle">EuroBureau is the AI-free, privacy-first, GDPR-compliant, transparent and open-source, online office customised for self-published authors.</p>
        <p class="launch-date">The official launch of EuroBureau is scheduled for December 1st, 2026.</p>
        <div class="cta-group">
          <a href="/register" class="btn">Try now</a>
          <a href="/login" class="btn btn-secondary">Log in</a>
        </div>
      </div>
    </section>

    <section class="screenshot">
      <div class="container">
        <img src="/editor.png" alt="EuroBureau editor" />
      </div>
    </section>

  </main>

  <footer>
    <div class="container">
      <p>&copy; 2026 EuroBureau &middot; <a href="/terms">Terms</a> &middot; <a href="/faq">FAQ</a></p>
    </div>
  </footer>
</body>
</html>
