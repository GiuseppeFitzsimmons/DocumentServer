<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; overflow: hidden; }
    #editor-container { width: 100%; height: 100%; }
  </style>
</head>
<body>
  <div id="editor-container"></div>
  <script src="<%= dsUrl %>/web-apps/apps/api/documents/api.js"></script>
  <script>
    var config = <%- JSON.stringify(editorConfig) %>;

    config.events = {
      onRequestSaveAs: function(event) {
        var title = event.data.title || 'Copy of ' + config.document.title;
        var url = event.data.url;
        fetch('/api/files/saveas', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title: title, url: url, fileId: '<%= fileId %>' })
        }).then(function(res) {
          if (!res.ok) throw new Error('Save As failed');
          return res.json();
        }).then(function(file) {
          window.location.href = '/editor/' + file.id;
        }).catch(function(err) {
          alert(err.message || 'Save As failed');
        });
      },
      onRequestRename: function(event) {
        var newName = event.data;
        fetch('/api/files/<%= fileId %>', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: newName })
        }).then(function(res) {
          if (!res.ok) throw new Error('Rename failed');
          document.title = newName;
        }).catch(function(err) {
          alert(err.message || 'Rename failed');
        });
      }
    };

    new DocsAPI.DocEditor('editor-container', config);

    // POC: Inject CSS into the editor iframe to hide all fonts except Arial
    (function injectFontFilter() {
      function tryInject() {
        var iframe = document.querySelector('#editor-container iframe');
        if (!iframe) { setTimeout(tryInject, 500); return; }
        try {
          var iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
          var style = iframeDoc.createElement('style');
          style.textContent = `
            /* Hide all font items in the dropdown */
            .listview .item[data-value] { display: none !important; }
            /* Show only Arial */
            .listview .item[data-value="Arial"] { display: flex !important; }
          `;
          iframeDoc.head.appendChild(style);
        } catch (e) {
          // iframe not ready yet, retry
          setTimeout(tryInject, 500);
        }
      }
      setTimeout(tryInject, 2000);
    })();
  </script>
</body>
</html>
