<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; overflow: hidden; }
    #editor-container { width: 100%; height: 100%; }
  </style>
</head>
<body>
  <div id="editor-container"></div>
  <script src="<%= dsUrl %>/web-apps/apps/api/documents/api.js"></script>
  <script>
    var config = <%- JSON.stringify(editorConfig) %>;

    config.events = {
      onRequestSaveAs: function(event) {
        var title = event.data.title || 'Copy of ' + config.document.title;
        var url = event.data.url;
        fetch('/api/files/saveas', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title: title, url: url, fileId: '<%= fileId %>' })
        }).then(function(res) {
          if (!res.ok) throw new Error('Save As failed');
          return res.json();
        }).then(function(file) {
          window.location.href = '/editor/' + file.id;
        }).catch(function(err) {
          alert(err.message || 'Save As failed');
        });
      },
      onRequestRename: function(event) {
        var newName = event.data;
        fetch('/api/files/<%= fileId %>', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: newName })
        }).then(function(res) {
          if (!res.ok) throw new Error('Rename failed');
          document.title = newName;
        }).catch(function(err) {
          alert(err.message || 'Rename failed');
        });
      }
    };

    new DocsAPI.DocEditor('editor-container', config);

    // POC: Filter font list in editor to show only "Arial"
    (function injectFontFilter() {
      var allowedFonts = ['Arial'];

      function tryInject() {
        var iframe = document.querySelector('#editor-container iframe');
        if (!iframe) { setTimeout(tryInject, 500); return; }
        try {
          var iframeWin = iframe.contentWindow;
          var iframeDoc = iframe.contentDocument || iframeWin.document;

          // Wait for the editor's Common.UI framework to be ready
          if (!iframeWin.Common || !iframeWin.Common.NotificationCenter) {
            setTimeout(tryInject, 1000);
            return;
          }

          // Listen for the fonts:load event to filter after fonts are populated
          iframeWin.Common.NotificationCenter.on('fonts:load', function(store) {
            filterFontStore(store);
          });

          // Also try to filter if fonts are already loaded
          // The font combobox lives in the toolbar; find it via the DOM
          setTimeout(function() { filterExistingFonts(iframeWin, iframeDoc); }, 3000);

        } catch (e) {
          setTimeout(tryInject, 1000);
        }
      }

      function filterFontStore(store) {
        if (!store || !store.models) return;
        var toRemove = store.models.filter(function(m) {
          return allowedFonts.indexOf(m.get('name')) === -1;
        });
        toRemove.forEach(function(m) { store.remove(m); });
      }

      function filterExistingFonts(iframeWin, iframeDoc) {
        try {
          // Try to access the font store through the toolbar controller
          var app = iframeWin.require && iframeWin.require('core/app');
          if (!app) return;

          // Alternative: find all li elements in font dropdown and hide non-matching
          var fontMenus = iframeDoc.querySelectorAll('.dropdown-menu.scrollable-menu li:not(.divider)');
          fontMenus.forEach(function(li) {
            var a = li.querySelector('a.font-item');
            if (!a) return;
            // The item stores font info; check via the tooltip/title or the store
            // Since we can't easily get the name from canvas, hide all except first N (recent) items
            // This is a rough approach - proper filtering needs store access
          });
        } catch(e) {}
      }

      setTimeout(tryInject, 2000);
    })();
  </script>
</body>
</html>
