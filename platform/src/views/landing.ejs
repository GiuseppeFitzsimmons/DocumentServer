<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EuroBureau</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <!-- Navigation Bar -->
  <nav class="navbar">
    <a href="/" class="navbar-brand">EuroBureau</a>
    <div class="navbar-right">
      <a href="/account" class="navbar-user"><%= displayName %></a>
      <a href="/logout" class="navbar-logout">Logout</a>
    </div>
  </nav>

  <!-- Toast Container -->
  <div class="toast-container" id="toast-container"></div>

  <!-- Hidden file input for upload -->
  <input type="file" id="file-upload-input" style="display:none">

  <div class="main-content">
    <!-- Create Section -->
    <section class="section" id="create-section">
      <h2 class="section-heading">Create a new document</h2>
      <div class="create-grid">
        <div class="card create-card" data-type="docx" style="border-top-color: #4285F4" onclick="handleCreateDocument('docx')">
          <div class="create-card-icon">📄</div>
          <div class="create-card-label">Blank document</div>
        </div>
        <div class="card create-card" data-type="xlsx" style="border-top-color: #34A853" onclick="handleCreateDocument('xlsx')">
          <div class="create-card-icon">📊</div>
          <div class="create-card-label">Spreadsheet</div>
        </div>
      </div>
    </section>

    <!-- Recent Documents Section -->
    <section class="section" id="recent-section">
      <h2 class="section-heading">Recent documents</h2>
      <div class="recent-grid" id="recent-grid"></div>
    </section>

    <!-- Browser Section -->
    <section class="section" id="browser-section">
      <div class="browser-toolbar">
        <h2 class="browser-heading">My files</h2>
        <button class="btn-toolbar" id="btn-upload" onclick="handleUploadClick()">Upload</button>
        <button class="btn-toolbar" id="btn-new-folder" onclick="handleNewFolder()">New Folder</button>
      </div>
      <div class="file-tree-container" id="fileTreeContainer">
        <div class="file-tree" id="fileTree" role="tree" aria-label="File browser"></div>
      </div>
    </section>

    <!-- Shared With Me Section -->
    <section class="section" id="shared-section" aria-label="Files shared with me">
      <h2 class="section-heading">Shared with me</h2>
      <div class="shared-list" role="list" aria-label="Shared files list">
        <div class="shared-list-header" aria-hidden="true">
          <span>Name</span>
          <span>Owner</span>
          <span>Shared</span>
          <span>Permissions</span>
        </div>
        <div id="shared-grid" role="group"></div>
      </div>
    </section>

    <!-- Placeholder Section -->
    <section class="section" id="placeholder-section">
      <h2 class="section-heading">Coming soon</h2>
      <div class="placeholder-grid">
        <div class="card placeholder-card">
          <div class="placeholder-label">Custom Fonts</div>
          <span class="placeholder-badge">Coming Soon</span>
        </div>
      </div>
    </section>
  </div>

  <script>
    // Embedded data from server
    var initialItems = <%- initialItems %>;
    var recentFiles = <%- recentFiles %>;
    var displayName = "<%= displayName %>";

    // ========================================
    // File Manager API Module
    // ========================================
    window.FileManagerAPI = {
      async listFolder(folderId) {
        const url = folderId ? '/api/files?folderId=' + encodeURIComponent(folderId) : '/api/files';
        const res = await fetch(url);
        if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
        if (!res.ok) { const err = await res.text(); throw new Error(err || 'Failed to list folder'); }
        const items = await res.json();
        var files = [];
        var folders = [];
        items.forEach(function(item) {
          if (item.type === 'folder') {
            folders.push({ id: item.id, name: item.name, updatedAt: item.updatedAt });
          } else {
            files.push({ id: item.id, name: item.name, mimeType: item.mimeType, sizeBytes: item.size, updatedAt: item.updatedAt });
          }
        });
        return { files: files, folders: folders };
      },

      async createDocument(type, folderId) {
        const body = { type };
        if (folderId) body.folderId = folderId;
        const res = await fetch('/api/files/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
        if (!res.ok) { const err = await res.text(); throw new Error(err || 'Failed to create document'); }
        return res.json();
      },

      async createFolder(name, parentId) {
        const body = { name };
        if (parentId) body.parentId = parentId;
        const res = await fetch('/api/folders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
        if (!res.ok) { const err = await res.text(); throw new Error(err || 'Failed to create folder'); }
        return res.json();
      },

      async uploadFile(file, folderId) {
        const formData = new FormData();
        formData.append('file', file);
        if (folderId) formData.append('folderId', folderId);
        const res = await fetch('/api/files/upload', {
          method: 'POST',
          body: formData
        });
        if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
        if (!res.ok) { const err = await res.text(); throw new Error(err || 'Failed to upload file'); }
        return res.json();
      },

      async renameFile(id, name) {
        const res = await fetch('/api/files/' + encodeURIComponent(id), {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name })
        });
        if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
        if (!res.ok) { const err = await res.text(); throw new Error(err || 'Failed to rename file'); }
        return res.json();
      },

      async renameFolder(id, name) {
        const res = await fetch('/api/folders/' + encodeURIComponent(id), {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name })
        });
        if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
        if (!res.ok) { const err = await res.text(); throw new Error(err || 'Failed to rename folder'); }
        return res.json();
      },

      async deleteFile(id) {
        const res = await fetch('/api/files/' + encodeURIComponent(id), { method: 'DELETE' });
        if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
        if (!res.ok) { const err = await res.text(); throw new Error(err || 'Failed to delete file'); }
      },

      async deleteFolder(id) {
        const res = await fetch('/api/folders/' + encodeURIComponent(id), { method: 'DELETE' });
        if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
        if (res.status === 409) { throw new Error('Folder must be empty before it can be deleted'); }
        if (!res.ok) { const err = await res.text(); throw new Error(err || 'Failed to delete folder'); }
      },

      async moveFile(id, targetFolderId) {
        const res = await fetch('/api/files/' + encodeURIComponent(id), {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ folderId: targetFolderId })
        });
        if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
        if (!res.ok) { const err = await res.text(); throw new Error(err || 'Failed to move file'); }
        return res.json();
      },

      async moveFolder(id, targetFolderId) {
        const res = await fetch('/api/folders/' + encodeURIComponent(id), {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ parentId: targetFolderId })
        });
        if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
        if (!res.ok) { const err = await res.text(); throw new Error(err || 'Failed to move folder'); }
        return res.json();
      }
    };

    // ========================================
    // Toast Notification System
    // ========================================
    function showToast(message, type) {
      var container = document.getElementById('toast-container');
      var toast = document.createElement('div');
      toast.className = 'toast toast-' + type;
      toast.textContent = message;
      toast.onclick = function() { toast.remove(); };
      container.appendChild(toast);
      setTimeout(function() { if (toast.parentNode) toast.remove(); }, 5000);
    }

    function showError(message) { showToast(message, 'error'); }
    function showSuccess(message) { showToast(message, 'success'); }

    // ========================================
    // Utility Functions
    // ========================================
    function getFileIcon(mimeType) {
      if (!mimeType) return '📄';
      if (mimeType.includes('spreadsheet') || mimeType.includes('xlsx')) return '📊';
      return '📄';
    }

    function formatDate(dateStr) {
      if (!dateStr) return '';
      var d = new Date(dateStr);
      var now = new Date();
      var diff = now - d;
      if (diff < 60000) return 'Just now';
      if (diff < 3600000) return Math.floor(diff / 60000) + ' min ago';
      if (diff < 86400000) return Math.floor(diff / 3600000) + 'h ago';
      if (diff < 604800000) return Math.floor(diff / 86400000) + 'd ago';
      return d.toLocaleDateString();
    }

    function formatSize(bytes) {
      if (!bytes && bytes !== 0) return '\u2014';
      if (bytes === 0) return '0 B';
      var units = ['B', 'KB', 'MB', 'GB'];
      var i = Math.floor(Math.log(bytes) / Math.log(1024));
      if (i >= units.length) i = units.length - 1;
      var val = bytes / Math.pow(1024, i);
      return (i === 0 ? val : val.toFixed(1)) + ' ' + units[i];
    }

    function escapeHtml(str) {
      if (!str) return '';
      var div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    function isDocxFile(name, mimeType) {
      var docxMime = 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
      if (mimeType === docxMime) return true;
      if (name && name.toLowerCase().endsWith('.docx')) return true;
      return false;
    }

    async function exportAsEpub(fileId, fileName) {
      var container = document.getElementById('toastContainer') || document.body;
      var loadingToast = document.createElement('div');
      loadingToast.className = 'toast';
      loadingToast.textContent = 'Exporting to EPUB\u2026';
      container.appendChild(loadingToast);
      setTimeout(function() { loadingToast.classList.add('visible'); }, 10);

      try {
        var res = await fetch('/api/files/' + encodeURIComponent(fileId) + '/export/epub');
        loadingToast.remove();

        if (!res.ok) {
          var err = await res.json().catch(function() { return { error: 'Export failed' }; });
          alert(err.error || 'Export failed');
          return;
        }

        var blob = await res.blob();
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = fileName.replace(/\.docx$/i, '.epub');
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      } catch (e) {
        loadingToast.remove();
        alert('Export failed: ' + (e.message || 'Unknown error'));
      }
    }

    // ========================================
    // Create Section Handlers
    // ========================================
    async function handleCreateDocument(type) {
      try {
        var result = await FileManagerAPI.createDocument(type, null);
        window.open('/editor/' + result.id, '_blank');
      } catch (err) {
        showError(err.message || 'Failed to create document');
      }
    }

    // ========================================
    // Recent Documents Section
    // ========================================
    function renderRecentSection(files) {
      var grid = document.getElementById('recent-grid');
      grid.innerHTML = '';
      if (!files || files.length === 0) {
        grid.innerHTML = '<div class="empty-state">No recent documents yet</div>';
        return;
      }
      files.forEach(function(file) {
        var card = document.createElement('a');
        card.href = '/editor/' + file.id;
        card.target = '_blank';
        card.className = 'card document-card';
        card.innerHTML =
          '<div class="document-card-icon">' + getFileIcon(file.mimeType) + '</div>' +
          '<div class="document-card-name">' + escapeHtml(file.name) + '</div>' +
          '<div class="document-card-date">' + formatDate(file.updatedAt) + '</div>';
        grid.appendChild(card);
      });
    }

    // ========================================
    // Breadcrumb (removed — section title is sufficient)
    // ========================================
    function renderBreadcrumb() {
      document.title = 'My files - EuroBureau';
    }

    // ========================================
    // File Tree Browser (unified tree showing files + folders)
    // ========================================
    var fileTreeCache = new Map();
    var expandedFolders = new Set();
    var activeContextMenuNode = null;

    async function initFileTree() {
      try {
        fileTreeCache.set(null, initialItems);
        renderFileTree();
      } catch(err) {
        document.getElementById('fileTree').innerHTML = '<div class="file-tree-empty">Failed to load files</div>';
      }
    }

    function renderFileTree() {
      var container = document.getElementById('fileTree');
      container.innerHTML = '';
      var rootData = fileTreeCache.get(null);
      if (!rootData) return;
      renderTreeLevel(container, rootData, null, 0);
    }

    function renderTreeLevel(parentEl, data, parentFolderId, depth) {
      var folders = (data.folders || []).slice().sort(function(a, b) {
        return a.name.toLowerCase().localeCompare(b.name.toLowerCase());
      });
      var files = (data.files || []).slice().sort(function(a, b) {
        return a.name.toLowerCase().localeCompare(b.name.toLowerCase());
      });

      if (folders.length === 0 && files.length === 0 && depth > 0) {
        var emptyEl = document.createElement('div');
        emptyEl.className = 'file-tree-empty';
        emptyEl.textContent = 'Empty folder';
        parentEl.appendChild(emptyEl);
        return;
      }

      if (folders.length === 0 && files.length === 0 && depth === 0) {
        var emptyRoot = document.createElement('div');
        emptyRoot.className = 'empty-state';
        emptyRoot.textContent = 'No files yet. Upload a file or create a document to get started.';
        parentEl.appendChild(emptyRoot);
        return;
      }

      // Render folders first
      folders.forEach(function(folder) {
        var isExpanded = expandedFolders.has(folder.id);

        var node = document.createElement('div');
        node.className = 'file-tree-node';
        node.setAttribute('data-id', folder.id);
        node.setAttribute('data-type', 'folder');
        node.setAttribute('data-name', folder.name);

        var item = document.createElement('div');
        item.className = 'file-tree-item';
        item.setAttribute('draggable', 'true');

        var arrow = document.createElement('span');
        arrow.className = 'file-tree-arrow' + (isExpanded ? ' expanded' : '');
        arrow.textContent = '\u25B6';

        var icon = document.createElement('span');
        icon.className = 'file-tree-icon';
        icon.textContent = '\uD83D\uDCC1';

        var name = document.createElement('span');
        name.className = 'file-tree-name folder-name';
        name.textContent = folder.name;

        var actions = document.createElement('button');
        actions.className = 'file-tree-actions';
        actions.textContent = '\u22EE';
        actions.onclick = function(e) { e.stopPropagation(); showTreeContextMenu(e, folder.id, 'folder', folder.name); };

        item.appendChild(arrow);
        item.appendChild(icon);
        item.appendChild(name);
        item.appendChild(actions);
        node.appendChild(item);

        // Children container
        var childrenEl = document.createElement('div');
        childrenEl.className = 'file-tree-children';
        childrenEl.style.display = isExpanded ? '' : 'none';
        node.appendChild(childrenEl);

        if (isExpanded) {
          var cachedData = fileTreeCache.get(folder.id);
          if (cachedData) {
            renderTreeLevel(childrenEl, cachedData, folder.id, depth + 1);
          } else {
            var loadingEl = document.createElement('div');
            loadingEl.className = 'file-tree-loading';
            loadingEl.textContent = 'Loading...';
            childrenEl.appendChild(loadingEl);
          }
        }

        // Click to expand/collapse
        item.onclick = function(e) {
          if (e.target.closest('.file-tree-actions')) return;
          if (isExpanded) {
            expandedFolders.delete(folder.id);
            renderFileTree();
          } else {
            expandFolder(folder.id);
          }
        };

        // Drag and drop on folders
        item.addEventListener('dragstart', function(e) {
          e.dataTransfer.setData('text/plain', JSON.stringify({ id: folder.id, type: 'folder' }));
          e.dataTransfer.effectAllowed = 'move';
          item.style.opacity = '0.5';
        });
        item.addEventListener('dragend', function() { item.style.opacity = '1'; });
        item.addEventListener('dragover', function(e) {
          e.preventDefault();
          e.dataTransfer.dropEffect = 'move';
          item.classList.add('drag-over');
        });
        item.addEventListener('dragleave', function() { item.classList.remove('drag-over'); });
        item.addEventListener('drop', function(e) {
          e.preventDefault();
          item.classList.remove('drag-over');
          handleTreeDrop(e, folder.id);
        });

        parentEl.appendChild(node);
      });

      // Render files
      files.forEach(function(file) {
        var node = document.createElement('div');
        node.className = 'file-tree-node';
        node.setAttribute('data-id', file.id);
        node.setAttribute('data-type', 'file');
        node.setAttribute('data-name', file.name);

        var item = document.createElement('div');
        item.className = 'file-tree-item';
        item.setAttribute('draggable', 'true');

        var arrow = document.createElement('span');
        arrow.className = 'file-tree-arrow hidden';

        var icon = document.createElement('span');
        icon.className = 'file-tree-icon';
        icon.textContent = getFileIcon(file.mimeType);

        var name = document.createElement('span');
        name.className = 'file-tree-name';
        name.textContent = file.name;

        var meta = document.createElement('span');
        meta.className = 'file-tree-meta';
        meta.textContent = formatSize(file.sizeBytes);

        var actions = document.createElement('button');
        actions.className = 'file-tree-actions';
        actions.textContent = '\u22EE';
        actions.onclick = function(e) { e.stopPropagation(); showTreeContextMenu(e, file.id, 'file', file.name, file.mimeType); };

        item.appendChild(arrow);
        item.appendChild(icon);
        item.appendChild(name);
        item.appendChild(meta);
        if (isDocxFile(file.name, file.mimeType)) {
          var exportBtn = document.createElement('button');
          exportBtn.className = 'file-tree-actions epub-export-btn';
          exportBtn.title = 'Export as EPUB';
          exportBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>';
          exportBtn.onclick = function(e) { e.stopPropagation(); exportAsEpub(file.id, file.name); };
          item.appendChild(exportBtn);
        }
        item.appendChild(actions);
        node.appendChild(item);

        // Click to open file
        item.onclick = function(e) {
          if (e.target.closest('.file-tree-actions') || e.target.closest('.epub-export-btn')) return;
          window.open('/editor/' + file.id, '_blank');
        };

        // Drag
        item.addEventListener('dragstart', function(e) {
          e.dataTransfer.setData('text/plain', JSON.stringify({ id: file.id, type: 'file' }));
          e.dataTransfer.effectAllowed = 'move';
          item.style.opacity = '0.5';
        });
        item.addEventListener('dragend', function() { item.style.opacity = '1'; });

        parentEl.appendChild(node);
      });
    }

    async function expandFolder(folderId) {
      expandedFolders.add(folderId);
      renderFileTree();

      if (fileTreeCache.has(folderId)) {
        return;
      }

      try {
        var data = await FileManagerAPI.listFolder(folderId);
        fileTreeCache.set(folderId, data);
        renderFileTree();
      } catch(err) {
        expandedFolders.delete(folderId);
        renderFileTree();
        showError('Failed to load folder');
      }
    }

    // ========================================
    // Tree Context Menu
    // ========================================
    function showTreeContextMenu(e, id, type, name, mimeType) {
      closeTreeContextMenu();
      var menu = document.createElement('div');
      menu.className = 'context-menu visible';
      menu.style.position = 'fixed';
      menu.style.top = e.clientY + 'px';
      menu.style.left = e.clientX + 'px';
      menu.style.zIndex = '1000';

      if (type === 'file' && isDocxFile(name, mimeType)) {
        var exportBtn = document.createElement('button');
        exportBtn.className = 'context-menu-item';
        exportBtn.textContent = 'Export as EPUB';
        exportBtn.onclick = function() { closeTreeContextMenu(); exportAsEpub(id, name); };
        menu.appendChild(exportBtn);
      }

      var renameBtn = document.createElement('button');
      renameBtn.className = 'context-menu-item';
      renameBtn.textContent = 'Rename';
      renameBtn.onclick = function() { closeTreeContextMenu(); handleTreeRename(id, type); };
      menu.appendChild(renameBtn);

      var moveBtn = document.createElement('button');
      moveBtn.className = 'context-menu-item';
      moveBtn.textContent = 'Move';
      moveBtn.onclick = function() { closeTreeContextMenu(); handleMove(id, type); };
      menu.appendChild(moveBtn);

      var deleteBtn = document.createElement('button');
      deleteBtn.className = 'context-menu-item danger';
      deleteBtn.textContent = 'Delete';
      deleteBtn.onclick = function() { closeTreeContextMenu(); handleTreeDelete(id, type, name); };
      menu.appendChild(deleteBtn);

      document.body.appendChild(menu);
      activeContextMenuNode = menu;

      setTimeout(function() {
        var rect = menu.getBoundingClientRect();
        if (rect.right > window.innerWidth) {
          menu.style.left = (window.innerWidth - rect.width - 8) + 'px';
        }
        if (rect.bottom > window.innerHeight) {
          menu.style.top = (window.innerHeight - rect.height - 8) + 'px';
        }
      }, 0);
    }

    function closeTreeContextMenu() {
      if (activeContextMenuNode) {
        activeContextMenuNode.remove();
        activeContextMenuNode = null;
      }
    }

    document.addEventListener('click', function(e) {
      if (!e.target.closest('.context-menu') && !e.target.closest('.file-tree-actions')) {
        closeTreeContextMenu();
      }
    });

    // ========================================
    // Tree Rename
    // ========================================
    function handleTreeRename(id, type) {
      var node = document.querySelector('.file-tree-node[data-id="' + id + '"]');
      if (!node) return;
      var nameEl = node.querySelector('.file-tree-name');
      var originalName = nameEl.textContent;

      var input = document.createElement('input');
      input.type = 'text';
      input.className = 'rename-input';
      input.value = originalName;
      nameEl.textContent = '';
      nameEl.appendChild(input);
      input.focus();
      input.select();

      var submitted = false;
      async function submit() {
        if (submitted) return;
        submitted = true;
        var newName = input.value.trim();
        if (!newName || newName === originalName) {
          nameEl.textContent = originalName;
          return;
        }
        try {
          if (type === 'file') {
            await FileManagerAPI.renameFile(id, newName);
          } else {
            await FileManagerAPI.renameFolder(id, newName);
          }
          nameEl.textContent = newName;
          node.setAttribute('data-name', newName);
          updateNameInCache(id, type, newName);
          showSuccess('Renamed successfully');
        } catch(err) {
          nameEl.textContent = originalName;
          showError(err.message || 'Failed to rename');
        }
      }

      input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); submit(); }
        if (e.key === 'Escape') { nameEl.textContent = originalName; }
      });
      input.addEventListener('blur', submit);
    }

    // ========================================
    // Tree Delete
    // ========================================
    async function handleTreeDelete(id, type, name) {
      if (!confirm('Are you sure you want to delete "' + name + '"?')) return;
      try {
        if (type === 'file') {
          await FileManagerAPI.deleteFile(id);
        } else {
          await FileManagerAPI.deleteFolder(id);
        }
        removeFromCache(id, type);
        if (type === 'folder') {
          expandedFolders.delete(id);
          fileTreeCache.delete(id);
        }
        renderFileTree();
        showSuccess('Deleted successfully');
      } catch(err) {
        showError(err.message || 'Failed to delete');
      }
    }

    // ========================================
    // Tree Drag and Drop
    // ========================================
    async function handleTreeDrop(e, targetFolderId) {
      var data;
      try { data = JSON.parse(e.dataTransfer.getData('text/plain')); } catch(err) { return; }
      if (data.id === targetFolderId) return;
      try {
        if (data.type === 'file') {
          await FileManagerAPI.moveFile(data.id, targetFolderId);
        } else {
          await FileManagerAPI.moveFolder(data.id, targetFolderId);
        }
        removeFromCache(data.id, data.type);
        fileTreeCache.delete(targetFolderId);
        // Refresh the target level
        if (targetFolderId === null || expandedFolders.has(targetFolderId)) {
          var freshData = await FileManagerAPI.listFolder(targetFolderId);
          fileTreeCache.set(targetFolderId, freshData);
        }
        renderFileTree();
        showSuccess('Moved to ' + (targetFolderId === null ? 'root' : 'folder'));
      } catch(err) {
        showError(err.message || 'Failed to move');
      }
    }

    // Drop to root: dropping on the tree container background moves item to root
    (function initRootDrop() {
      var treeContainer = document.getElementById('fileTreeContainer');
      treeContainer.addEventListener('dragover', function(e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
      });
      treeContainer.addEventListener('drop', function(e) {
        // Only handle if the drop target is the container itself (not a folder item)
        if (e.target.closest('.file-tree-item')) return;
        e.preventDefault();
        handleTreeDrop(e, null);
      });
    })();

    // ========================================
    // Cache Helpers
    // ========================================
    function removeFromCache(id, type) {
      fileTreeCache.forEach(function(data) {
        if (type === 'folder') {
          data.folders = (data.folders || []).filter(function(f) { return f.id !== id; });
        } else {
          data.files = (data.files || []).filter(function(f) { return f.id !== id; });
        }
      });
    }

    function updateNameInCache(id, type, newName) {
      fileTreeCache.forEach(function(data) {
        if (type === 'folder') {
          (data.folders || []).forEach(function(f) {
            if (f.id === id) f.name = newName;
          });
        } else {
          (data.files || []).forEach(function(f) {
            if (f.id === id) f.name = newName;
          });
        }
      });
    }

    // ========================================
    // Upload and New Folder
    // ========================================
    function handleUploadClick() {
      document.getElementById('file-upload-input').click();
    }

    document.getElementById('file-upload-input').addEventListener('change', async function(e) {
      var file = e.target.files[0];
      if (!file) return;
      e.target.value = '';

      var overlay = document.createElement('div');
      overlay.className = 'upload-overlay';
      overlay.innerHTML = '<div class="upload-progress"><div class="upload-spinner"></div><div>Uploading...</div></div>';
      document.body.appendChild(overlay);

      try {
        await FileManagerAPI.uploadFile(file, null);
        showSuccess('File uploaded successfully');
        var data = await FileManagerAPI.listFolder(null);
        fileTreeCache.set(null, data);
        renderFileTree();
      } catch (err) {
        showError(err.message || 'Failed to upload file');
      } finally {
        overlay.remove();
      }
    });

    async function handleNewFolder() {
      var name = prompt('Enter folder name:');
      if (!name || !name.trim()) return;
      name = name.trim();
      try {
        await FileManagerAPI.createFolder(name, null);
        showSuccess('Folder created');
        var data = await FileManagerAPI.listFolder(null);
        fileTreeCache.set(null, data);
        renderFileTree();
      } catch (err) {
        showError(err.message || 'Failed to create folder');
      }
    }

    // ========================================
    // Move (Folder Picker Modal)
    // ========================================
    async function handleMove(id, type) {
      closeTreeContextMenu();
      try {
        var tree = await fetch('/api/folders/tree').then(function(r) { return r.json(); });
        showFolderPicker(tree, id, type);
      } catch (err) {
        showError(err.message || 'Failed to load folders');
      }
    }

    function showFolderPicker(tree, itemId, itemType) {
      var overlay = document.createElement('div');
      overlay.className = 'modal-overlay';

      var selectedFolderId = undefined;

      var disabledIds = new Set();
      if (itemType === 'folder') {
        disabledIds.add(itemId);
        addDescendantIds(tree, itemId, disabledIds);
      }

      var folderListHtml = '<div class="modal-folder-item" data-folder-id="__root__">\uD83D\uDCC1 My files (root)</div>';
      folderListHtml += renderPickerTreeHtml(tree, 0, disabledIds, itemId);

      overlay.innerHTML =
        '<div class="modal">' +
          '<div class="modal-title">Move to folder</div>' +
          '<div class="modal-folder-list">' + folderListHtml + '</div>' +
          '<div class="modal-actions">' +
            '<button class="modal-btn modal-btn-cancel" id="modal-cancel">Cancel</button>' +
            '<button class="modal-btn modal-btn-confirm" id="modal-confirm">Move</button>' +
          '</div>' +
        '</div>';

      document.body.appendChild(overlay);

      overlay.querySelectorAll('.modal-folder-item:not(.disabled)').forEach(function(el) {
        el.onclick = function() {
          overlay.querySelectorAll('.modal-folder-item').forEach(function(i) { i.classList.remove('selected'); });
          el.classList.add('selected');
          var fid = el.getAttribute('data-folder-id');
          selectedFolderId = fid === '__root__' ? null : fid;
        };
      });

      overlay.querySelector('#modal-cancel').onclick = function() { overlay.remove(); };
      overlay.querySelector('#modal-confirm').onclick = async function() {
        if (selectedFolderId === undefined) { showError('Please select a folder'); return; }
        overlay.remove();
        try {
          if (itemType === 'file') {
            await FileManagerAPI.moveFile(itemId, selectedFolderId);
          } else {
            await FileManagerAPI.moveFolder(itemId, selectedFolderId);
          }
          removeFromCache(itemId, itemType);
          fileTreeCache.delete(selectedFolderId);
          if (expandedFolders.has(selectedFolderId)) {
            var freshData = await FileManagerAPI.listFolder(selectedFolderId);
            fileTreeCache.set(selectedFolderId, freshData);
          }
          if (selectedFolderId === null) {
            var rootData = await FileManagerAPI.listFolder(null);
            fileTreeCache.set(null, rootData);
          }
          renderFileTree();
          showSuccess('Moved successfully');
        } catch (err) {
          showError(err.message || 'Failed to move');
        }
      };

      overlay.onclick = function(e) { if (e.target === overlay) overlay.remove(); };
    }

    function renderPickerTreeHtml(nodes, depth, disabledIds, currentItemId) {
      var html = '';
      nodes.forEach(function(node) {
        var isDisabled = disabledIds.has(node.id);
        var isCurrent = node.id === currentItemId;
        var indent = (depth * 16 + 12) + 'px';
        html += '<div class="modal-folder-item' + (isDisabled ? ' disabled' : '') + (isCurrent ? ' current-location' : '') + '" data-folder-id="' + node.id + '" style="padding-left:' + indent + '">\uD83D\uDCC1 ' + escapeHtml(node.name) + (isCurrent ? ' <span style="color:#999;font-size:11px">(current)</span>' : '') + '</div>';
        if (node.children && node.children.length > 0) {
          html += renderPickerTreeHtml(node.children, depth + 1, disabledIds, currentItemId);
        }
      });
      return html;
    }

    function addDescendantIds(tree, folderId, set) {
      tree.forEach(function(node) {
        if (node.id === folderId) {
          collectIds(node.children || [], set);
        } else if (node.children && node.children.length > 0) {
          addDescendantIds(node.children, folderId, set);
        }
      });
    }

    function collectIds(nodes, set) {
      nodes.forEach(function(node) {
        set.add(node.id);
        if (node.children && node.children.length > 0) {
          collectIds(node.children, set);
        }
      });
    }

    // ========================================
    // Shared With Me Section
    // ========================================
    async function loadSharedFiles() {
      try {
        var res = await fetch('/api/shares/my-files');
        if (res.status === 401) { window.location.href = '/login'; return; }
        if (!res.ok) { throw new Error('Failed to load shared files'); }
        var files = await res.json();
        renderSharedFiles(files);
      } catch (err) {
        var grid = document.getElementById('shared-grid');
        grid.innerHTML = '<div class="empty-state">Unable to load shared files</div>';
      }
    }

    function renderSharedFiles(files) {
      var grid = document.getElementById('shared-grid');
      grid.innerHTML = '';

      if (!files || files.length === 0) {
        grid.innerHTML = '<div class="empty-state">No files have been shared with you yet</div>';
        return;
      }

      files.forEach(function(file) {
        var link = document.createElement('a');
        link.href = '/editor/' + file.fileId;
        link.target = '_blank';
        link.className = 'shared-item';
        link.setAttribute('role', 'listitem');
        link.setAttribute('aria-label', 'Open shared file: ' + escapeHtml(file.fileName) + ', owned by ' + escapeHtml(file.ownerDisplayName));

        var icon = getFileIcon(file.fileType);
        var permBadges = getPermissionBadges(file.permissions);
        var sharedDate = formatDate(file.sharedAt);

        link.innerHTML =
          '<div class="shared-item-name-cell">' +
            '<span class="shared-item-icon" aria-hidden="true">' + icon + '</span>' +
            '<span class="shared-item-name">' + escapeHtml(file.fileName) + '</span>' +
          '</div>' +
          '<span class="shared-item-owner">' + escapeHtml(file.ownerDisplayName) + '</span>' +
          '<span class="shared-item-date">' + sharedDate + '</span>' +
          '<span class="shared-item-permissions">' + permBadges + '</span>';

        grid.appendChild(link);
      });
    }

    function getPermissionBadges(permissions) {
      var badges = [];
      if (permissions.edit) badges.push('<span class="perm-badge">Edit</span>');
      if (permissions.comment) badges.push('<span class="perm-badge">Comment</span>');
      if (permissions.review) badges.push('<span class="perm-badge">Review</span>');
      if (permissions.download) badges.push('<span class="perm-badge">Download</span>');
      if (badges.length === 0) badges.push('<span class="perm-badge">View</span>');
      return badges.join('');
    }

    // ========================================
    // Initialize on page load
    // ========================================
    (function init() {
      renderRecentSection(recentFiles);
      renderBreadcrumb();
      initFileTree();
      loadSharedFiles();
    })();
  </script>

  <!-- Support Widget -->
  <div id="support-widget" class="support-widget">
    <button id="support-toggle" class="support-toggle" aria-label="Contact support">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    </button>
    <div id="support-panel" class="support-panel" style="display:none;">
      <div class="support-panel-header">
        <span>Contact Support</span>
        <button id="support-close" class="support-panel-close" aria-label="Close">&times;</button>
      </div>
      <form id="support-form" class="support-form">
        <div class="support-field">
          <label for="support-subject">Subject</label>
          <input type="text" id="support-subject" name="subject" required maxlength="200" placeholder="Brief description of your issue" />
        </div>
        <div class="support-field">
          <label for="support-message">Message</label>
          <textarea id="support-message" name="message" required maxlength="5000" rows="5" placeholder="Describe your issue in detail..."></textarea>
        </div>
        <button type="submit" class="support-submit">Send</button>
      </form>
      <div id="support-success" class="support-success" style="display:none;">
        <p>Your message has been sent. We'll get back to you shortly.</p>
        <button id="support-reset" class="support-submit">Send another</button>
      </div>
    </div>
  </div>

  <style>
    .support-widget {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 900;
      font-family: inherit;
    }
    .support-toggle {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: #111;
      color: #fff;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 16px rgba(0,0,0,0.15);
      transition: background 0.15s;
    }
    .support-toggle:hover { background: #333; }
    .support-panel {
      position: absolute;
      bottom: 64px;
      right: 0;
      width: 340px;
      background: #fff;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.12);
      overflow: hidden;
    }
    .support-panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 1px solid #eee;
      font-size: 15px;
      font-weight: 500;
    }
    .support-panel-close {
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
      padding: 0 4px;
      color: #666;
    }
    .support-panel-close:hover { color: #111; }
    .support-form {
      padding: 20px;
    }
    .support-field {
      margin-bottom: 14px;
    }
    .support-field label {
      display: block;
      font-size: 13px;
      color: #444;
      margin-bottom: 4px;
    }
    .support-field input,
    .support-field textarea {
      width: 100%;
      padding: 9px 12px;
      border: 1px solid #ddd;
      border-radius: 3px;
      font-family: inherit;
      font-size: 14px;
      resize: vertical;
    }
    .support-field input:focus,
    .support-field textarea:focus {
      outline: none;
      border-color: #111;
    }
    .support-submit {
      width: 100%;
      padding: 10px;
      background: #111;
      color: #fff;
      border: none;
      border-radius: 3px;
      font-family: inherit;
      font-size: 14px;
      cursor: pointer;
      transition: background 0.15s;
    }
    .support-submit:hover { background: #333; }
    .support-success {
      padding: 32px 20px;
      text-align: center;
    }
    .support-success p {
      font-size: 14px;
      color: #444;
      margin: 0 0 16px;
      line-height: 1.6;
    }
    @media (max-width: 480px) {
      .support-panel { width: calc(100vw - 48px); right: 0; }
    }
  </style>

  <script>
    (function() {
      var toggle = document.getElementById('support-toggle');
      var panel = document.getElementById('support-panel');
      var closeBtn = document.getElementById('support-close');
      var form = document.getElementById('support-form');
      var successEl = document.getElementById('support-success');
      var resetBtn = document.getElementById('support-reset');

      toggle.addEventListener('click', function() {
        var visible = panel.style.display !== 'none';
        panel.style.display = visible ? 'none' : '';
        if (!visible) document.getElementById('support-subject').focus();
      });

      closeBtn.addEventListener('click', function() {
        panel.style.display = 'none';
      });

      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        var subject = document.getElementById('support-subject').value.trim();
        var message = document.getElementById('support-message').value.trim();
        if (!subject || !message) return;

        try {
          var res = await fetch('/api/support', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subject: subject, message: message })
          });
          if (!res.ok) {
            var data = await res.json();
            throw new Error(data.error || 'Failed to send');
          }
          form.style.display = 'none';
          successEl.style.display = '';
        } catch (err) {
          showToast(err.message, 'error');
        }
      });

      resetBtn.addEventListener('click', function() {
        form.reset();
        form.style.display = '';
        successEl.style.display = 'none';
      });
    })();
  </script>
</body>
</html>
