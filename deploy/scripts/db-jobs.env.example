# Environment variables for DB server scheduled jobs.
# Copy to /opt/euro-office/jobs.env on the DB server and fill in values.

DATABASE_URL=postgres://portal:your-db-password@localhost:5432/portal
REDIS_URL=redis://localhost:6379
STORAGE_BACKEND=s3
OVH_S3_ENDPOINT=https://s3.eu-west-par.io.cloud.ovh.net
OVH_S3_BUCKET=euro-office-replica
OVH_S3_ACCESS_KEY=
OVH_S3_SECRET_KEY=
OVH_S3_REGION=eu-west-par
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=noreply@eurobureau.eu
SMTP_PASS=
MAIL_DOMAIN=eurobureau.eu
DS_JWT_SECRET=
DS_URL=https://eurobureau.eu
PLATFORM_BASE_URL=https://eurobureau.eu
SESSION_SECRET=
