# Pinned to 9.3.2 — update digest and re-apply epub patch when upgrading
FROM ghcr.io/euro-office/documentserver@sha256:bb7ba0a9609f395c7848f48f86c3219f187d804a28239ec949bc5e97e1e778a5

USER root

# Override web-apps documenteditor bundle with patched version (epub export intercept)
COPY deploy/patches/documenteditor-app.js /var/www/euro-office/documentserver/web-apps/apps/documenteditor/main/app.js

# Remove the default core-fonts bundle
RUN rm -rf /var/www/euro-office/documentserver/core-fonts/*

# Copy our curated font set (msttcore still present at /usr/share/fonts/msttcore/)
COPY fonts/ /var/www/euro-office/documentserver/core-fonts/custom/

# Fix permissions and regenerate the font index
RUN chown -R ds:ds /var/www/euro-office/documentserver/core-fonts && \
    documentserver-generate-allfonts.sh true
