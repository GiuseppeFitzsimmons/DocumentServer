# Pinned to 9.3.1 (v9.3.2 tag) — the Euro-Office registry labels this as 9.3.2 but internal version is 9.3.1
FROM ghcr.io/euro-office/documentserver:v9.3.2

USER root

# Override web-apps documenteditor bundle with patched version (epub export intercept)
COPY deploy/patches/documenteditor-app.js /var/www/euro-office/documentserver/web-apps/apps/documenteditor/main/app.js

# Inject custom book page sizes into sdkjs (using sed — no node dependency)
RUN SIZES=',{name:"Trade Paperback (small)",w_mm:139.7,h_mm:215.9,w_tw:7921,h_tw:12247},{name:"Trade Paperback (Large)",w_mm:152.4,h_mm:228.6,w_tw:8641,h_tw:12962},{name:"6.14x9.21",w_mm:156,h_mm:233.9,w_tw:8845,h_tw:13262},{name:"7x10",w_mm:177.8,h_mm:254,w_tw:10081,h_tw:14401},{name:"8.25x11",w_mm:209.5,h_mm:279.4,w_tw:11879,h_tw:15842},{name:"Mass-Market Paperback",w_mm:107.95,h_mm:174.5,w_tw:6121,h_tw:9894},{name:"A Format",w_mm:110,h_mm:178,w_tw:6237,h_tw:10093},{name:"Penguin",w_mm:111,h_mm:181,w_tw:6294,h_tw:10263},{name:"B Format",w_mm:138,h_mm:216,w_tw:7825,h_tw:12304}' && \
    sed -i "s/\"Envelope Coukei 3\"/\"Envelope Coukei 3\"/;s/\(\"Envelope Coukei 3\"[^}]*}\)/\1${SIZES}/" \
      /var/www/euro-office/documentserver/sdkjs/word/sdk-all.js \
      /var/www/euro-office/documentserver/sdkjs/word/sdk-all-min.js

# Remove the default core-fonts bundle
RUN rm -rf /var/www/euro-office/documentserver/core-fonts/*

# Install word count plugin (Apache-2.0 licensed, from ONLYOFFICE plugin marketplace)
RUN mkdir -p /tmp/wc-plugin && \
    curl -sL "https://github.com/nicedoc/onlyoffice.github.io/archive/master.tar.gz" | \
    tar -xz --strip-components=4 -C /tmp/wc-plugin \
      "onlyoffice.github.io-master/sdkjs-plugins/content/wordscounter/" && \
    GUID=$(grep -oP '"asc\.\{[^}]+\}"' /tmp/wc-plugin/config.json | head -1 | tr -d '"') && \
    mv /tmp/wc-plugin "/var/www/euro-office/documentserver/sdkjs-plugins/$GUID" && \
    chown -R ds:ds "/var/www/euro-office/documentserver/sdkjs-plugins/$GUID"

# Copy our curated font set (msttcore still present at /usr/share/fonts/msttcore/)
COPY fonts/ /var/www/euro-office/documentserver/core-fonts/custom/

# Fix permissions and regenerate the font index
RUN chown -R ds:ds /var/www/euro-office/documentserver/core-fonts && \
    documentserver-generate-allfonts.sh true
