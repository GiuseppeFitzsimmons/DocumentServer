eurobureau.eu {
	# DocumentServer assets and API (public, needed by editor iframe)
	handle /web-apps/* {
		reverse_proxy documentserver:80
	}
	handle /sdkjs/* {
		reverse_proxy documentserver:80
	}
	handle /sdkjs-plugins/* {
		reverse_proxy documentserver:80
	}
	handle /fonts/* {
		reverse_proxy documentserver:80
	}
	handle /cache/* {
		reverse_proxy documentserver:80
	}
	handle /coauthoring/* {
		reverse_proxy documentserver:80
	}
	handle /doc/* {
		reverse_proxy documentserver:80
	}
	handle /healthcheck {
		reverse_proxy documentserver:80
	}
	handle /ConvertService.ashx {
		reverse_proxy documentserver:80
	}
	handle /printfile/* {
		reverse_proxy documentserver:80
	}

	# Versioned DS assets (e.g. /9.3.1-hash/web-apps/...)
	@versioned path_regexp ^/[0-9]+\.[0-9]+\.[0-9]+
	handle @versioned {
		reverse_proxy documentserver:80
	}

	# Everything else goes to portal (including /example, gated by auth)
	handle /* {
		reverse_proxy portal:3000
	}
}
