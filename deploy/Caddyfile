(geo-block) {
	import /etc/caddy/geo-blocked-matcher.caddy
	handle @blocked {
		header Content-Type "text/html; charset=utf-8"
		respond 403 {
			body `<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Access Restricted</title><style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;background-color:#f5f5f5;color:#333;display:flex;align-items:center;justify-content:center;min-height:100vh;padding:1rem}.c{background-color:#fff;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.1);max-width:520px;width:100%;padding:2.5rem;text-align:center}h1{font-size:1.5rem;margin-bottom:1rem;color:#222}p{font-size:1rem;line-height:1.6;margin-bottom:1rem;color:#555}.ct{margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid #eee}.ct p{font-size:.9rem;color:#666}a{color:#2563eb}</style></head><body><div class="c"><h1>&#128274; Access Restricted</h1><p>Access to this service is restricted based on your geographic location.</p><div class="ct"><p>If you believe this is an error, contact <a href="mailto:support@eurobureau.eu">support@eurobureau.eu</a></p></div></div></body></html>`
		}
	}
}

eurobureau.eu {
	import geo-block

	# DocumentServer assets and API (public, needed by editor iframe)
	handle /web-apps/* {
		reverse_proxy documentserver:80
	}
	handle /sdkjs/* {
		reverse_proxy documentserver:80
	}
	handle /sdkjs-plugins/* {
		reverse_proxy documentserver:80
	}
	handle /fonts/* {
		reverse_proxy documentserver:80
	}
	handle /cache/* {
		reverse_proxy documentserver:80
	}
	handle /coauthoring/* {
		reverse_proxy documentserver:80
	}
	handle /doc/* {
		reverse_proxy documentserver:80
	}
	handle /healthcheck {
		reverse_proxy documentserver:80
	}
	handle /ConvertService.ashx {
		reverse_proxy documentserver:80
	}
	handle /printfile/* {
		reverse_proxy documentserver:80
	}

	# Intercept downloadas requests — route through platform to intercept epub exports
	@downloadas path_regexp downloadas .*/downloadas/.*
	handle @downloadas {
		reverse_proxy portal:3000
	}

	# Versioned DS assets (e.g. /9.3.1-hash/web-apps/...)
	@versioned path_regexp ^/[0-9]+\.[0-9]+\.[0-9]+
	handle @versioned {
		reverse_proxy documentserver:80
	}

	# Everything else goes to portal (including /example, gated by auth)
	handle /* {
		reverse_proxy portal:3000
	}
}

www.eurobureau.eu {
	import geo-block

	redir https://eurobureau.eu{uri} permanent
}
