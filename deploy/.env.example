# Domain for TLS (Caddy auto-provisions Let's Encrypt cert)
DOMAIN=yourdomain.com

# Shared secret between portal and DocumentServer
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32

# Portal database
DB_PASSWORD=change-me-strong-password

# Session signing
SESSION_SECRET=change-me-another-random-string

# Hetzner Object Storage (S3-compatible)
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=euro-office-files
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=fsn1
