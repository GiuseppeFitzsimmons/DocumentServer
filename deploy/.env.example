# Copy to .env and fill in values
JWT_SECRET=your-jwt-secret
DB_PASSWORD=your-db-password
SESSION_SECRET=your-session-secret-min-16-chars

# SMTP (OVH relay)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=noreply@eurobureau.eu
SMTP_PASS=your-ovh-email-password

# OVH Object Storage (S3-compatible) — for off-site replication
OVH_S3_ENDPOINT=https://s3.eu-west-par.io.cloud.ovh.net
OVH_S3_BUCKET=euro-office-replica
OVH_S3_ACCESS_KEY=your-ovh-s3-access-key
OVH_S3_SECRET_KEY=your-ovh-s3-secret-key
OVH_S3_REGION=eu-west-par
