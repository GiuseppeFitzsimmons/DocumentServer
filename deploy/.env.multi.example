# Multi-server deployment environment variables
# Copy to .env on each app server

JWT_SECRET=your-jwt-secret
SESSION_SECRET=your-session-secret-min-16-chars

# External database (on dedicated DB server)
DATABASE_URL=postgres://portal:your-db-password@10.0.1.10:5432/portal
REDIS_URL=redis://10.0.1.10:6379

# Document Server URL (as seen by the portal container)
DS_URL=http://documentserver

# Platform URL (as seen externally / by DS callbacks)
PLATFORM_BASE_URL=https://dev.eurobureau.eu

# S3 primary storage
OVH_S3_ENDPOINT=https://s3.eu-west-par.io.cloud.ovh.net
OVH_S3_BUCKET=euro-office-replica
OVH_S3_ACCESS_KEY=your-s3-access-key
OVH_S3_SECRET_KEY=your-s3-secret-key
OVH_S3_REGION=eu-west-par

# SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=noreply@eurobureau.eu
SMTP_PASS=your-smtp-password
MAIL_DOMAIN=eurobureau.eu
