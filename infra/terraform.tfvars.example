# Copy this file to terraform.tfvars and fill in your values.
# Do NOT commit terraform.tfvars to version control.

hcloud_token   = "your-hetzner-api-token"
ssh_public_key = "ssh-ed25519 AAAA... you@machine"

jwt_secret     = "generate-a-strong-random-secret-here"
db_password    = "generate-a-strong-db-password"
session_secret = "generate-a-strong-session-secret"

repo_url = "https://github.com/GiuseppeFitzsimmons/DocumentServer.git"

# Optional overrides:
# server_type = "cx31"
# location    = "fsn1"

# Email (DKIM key as a single line with \n for line breaks)
# mail_domain      = "eurobureau.eu"
# dkim_private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# SMTP relay (OVH)
smtp_host = "ssl0.ovh.net"
smtp_port = 587
smtp_user = "noreply@eurobureau.eu"
smtp_pass = "your-ovh-email-password"

# OVH Object Storage (off-site replication)
ovh_s3_endpoint   = "https://s3.par.io.cloud.ovh.net"
ovh_s3_bucket     = "euro-office-replica"
ovh_s3_access_key = "your-ovh-s3-access-key"
ovh_s3_secret_key = "your-ovh-s3-secret-key"
ovh_s3_region     = "par"
